prebuilt_etc {
    name: "fstab.qcom",
    src: "fstab.qcom",
    vendor: true,
    ramdisk_available: true,
}

prebuilt_etc {
    name: "init.beckham.rc",
    src: "init.beckham.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.recovery.beckham.rc",
    src: "init.recovery.beckham.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "init.sys.beckham.rc",
    src: "init.sys.beckham.rc",
    sub_dir: "init",
}
